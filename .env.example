# ════════════════════════════════════════════════════════════════
# IT Maturity Assessment – Environment Variables
# Copy this file to .env and fill in the values.
# ════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-in-production
ALLOWED_ORIGINS=*

# ── Database ─────────────────────────────────────────────────────
# Default: SQLite (no setup required, perfect for local/demo)
DATABASE_URL=sqlite+aiosqlite:///./itmaturity.db
DATABASE_URL_SYNC=sqlite:///./itmaturity.db
# For production with PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/itmaturity
# DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/itmaturity

# ── Redis / Celery ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Search Provider ──────────────────────────────────────────────
# Options: stub | tavily | serpapi | bing
# Use "stub" for demo mode (no API key required)
SEARCH_PROVIDER=stub

# Tavily (https://tavily.com)
TAVILY_API_KEY=

# SerpAPI (https://serpapi.com)
SERPAPI_KEY=

# Bing Web Search (Azure Cognitive Services)
BING_API_KEY=

# ── LLM Provider ─────────────────────────────────────────────────
# Compatible with any OpenAI-compatible API.
# Use LLM_MODE=demo to run without any LLM API key.
LLM_MODE=demo          # demo | live
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_SECONDS=3600

# ── Caching ───────────────────────────────────────────────────────
# Cache completed assessments for this many days
CACHE_TTL_DAYS=7

# ── Evidence Collection ───────────────────────────────────────────
MAX_URLS_PER_RUN=60
FETCH_TIMEOUT_SECONDS=20
MAX_TEXT_CHARS_PER_DOC=30000
EVIDENCE_WINDOW_START=2023
EVIDENCE_WINDOW_END=2025

# ── Playwright ────────────────────────────────────────────────────
USE_PLAYWRIGHT=true
PLAYWRIGHT_HEADLESS=true

# ── Filesystem ────────────────────────────────────────────────────
ARTIFACTS_DIR=/artifacts
